# Sunny V2 — environment variables (copy to .env next to docker-compose.yml and fill in).
# .env is git-ignored. Never commit real values.

# --- host / network (used by docker-compose.yml) ---
TAILSCALE_IP=100.x.y.z                 # `tailscale ip -4` on the M-700; Syncthing listens here
TAILSCALE_HOSTNAME=host.tailnet.ts.net # `tailscale status --json` -> Self.DNSName (no trailing dot)

# --- Claude ---
CLAUDE_API_KEY=...
CLAUDE_BASE_URL=https://api.anthropic.com
SUNNY_MODEL_FAST=claude-haiku-5-5
SUNNY_MODEL_DEFAULT=claude-sonnet-5-5
SUNNY_MODEL_DEEP=claude-opus-5-5

# --- LLM gateway (USD) ---
LLM_SPEND_DAILY=10.0
LLM_SPEND_MONTHLY=150.0
LLM_MAX_CONCURRENT=2

# --- auth ---
# Generate with: docker compose run --rm --no-deps sunny python -m sunny.auth
ADMIN_PASSWORD_HASH=...
SESSION_MAX_AGE_HOURS=720
# Optional; if empty a random key is generated into the secrets volume
SESSION_SECRET=

# --- voice (not wired to a route yet) ---
VOSK_MODEL_PATH=
WHISPER_MODEL_SIZE=int8
WHISPER_MODEL_PATH=
SILERO_ONNX_PATH=
PIPER_MODEL_PATH=

# --- daily brief ---
GARMIN_USERNAME=                       # Garmin Connect login (sleep, steps, resting HR)
GARMIN_PASSWORD=
TIMEZONE=America/New_York
BRIEF_TIME=07:00
PUBLIC_URL=https://host.tailnet.ts.net/
OPENWEATHERMAP_API_KEY=
WEATHER_LOCATIONS=Milton,GA,US            # ";"-separated, e.g. Milton,GA,US;Kennesaw,GA,US
# Google OAuth client (Calendar + Gmail, read-only). The redirect URI must be registered on the
# client in Google Cloud; tailscale serve publishes port 5443 for it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://host.tailnet.ts.net:5443/auth/google/callback

# --- integrations not wired to a feature yet ---
NEXTCLOUD_CALDAV_URL=http://nextcloud/remote.php/dav
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_CALENDAR_ID=

# --- Nextcloud containers (only with `--profile calendar`) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=

# --- push ---
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PUBLIC_KEY=

# --- misc ---
LOG_LEVEL=INFO
