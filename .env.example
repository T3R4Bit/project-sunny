# Sunny V2 — environment variables (copy to .env and fill in real values)
# All real values must be stored in .sunny/secrets/ on the M-700.

# --- paths ---
SUNNY_VAULT_PATH=/data/sunny-vault
SUNNY_DB_PATH=.sunny/sunny.db
SUNNY_SECRET_DIR=.sunny/secrets

# --- Claude ---
CLAUDE_API_KEY=...
CLAUDE_BASE_URL=https://api.anthropic.com/v1
SUNNY_MODEL_FAST=claude-haiku-4-5-20251001
SUNNY_MODEL_DEFAULT=claude-sonnet-5-5
SUNNY_MODEL_DEEP=claude-opus-5-5

# --- LLM gateway ---
LLM_SPEND_DAILY=10.0
LLM_SPEND_MONTHLY=150.0
LLM_MAX_CONCURRENT=2
LLM_CONCURRENT_SLEEP=2

# --- auth ---
ADMIN_PASSWORD_HASH=...
SESSION_MAX_AGE_HOURS=720

# --- voice ---
VOSK_MODEL_PATH=/models/vosk-small-en-us
WHISPER_MODEL_SIZE=int8
WHISPER_MODEL_PATH=/models/whisper-small.en
SILERO_ONNX_PATH=/models/silero_vad.onnx
PIPER_MODEL_PATH=/models/piper-en-us-lessac-medium

# --- integrations ---
NEXTCLOUD_CALDAV_URL=...
NEXTCLOUD_USER=...
NEXTCLOUD_PASSWORD=...
NEXTCLOUD_CALENDAR_ID=...
GOOGLE_CREDS_PATH=.sunny/secrets/google_creds.json
GARMIN_USERNAME=...
GARMIN_PASSWORD=...

# --- push ---
PUSH_VAPID_PRIVATE_KEY=...
PUSH_VAPID_PUBLIC_KEY=...

# --- misc ---
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
LOG_LEVEL=INFO
